# Verdict — production config. Copy to .env (local) and fill in.
# Get a Gemini key at https://aistudio.google.com/app/apikey
# Firebase values: Firebase console → Project settings → Your apps → SDK setup.
# Next.js loads .env automatically — GEMINI_API_KEY is REQUIRED (no mock fallback).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Firebase backend (client SDK — safe to expose, locked down by security rules)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Firebase Admin (server only — ID-token verification needs just the project ID)
FIREBASE_PROJECT_ID=
# Optional: service-account credentials for server-side quota enforcement.
# Local dev: point at the downloaded JSON key file.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# Hosted (e.g. Vercel, no file system): paste the FULL JSON key content.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# Optional: App Check reCAPTCHA v3 site key (Firebase console → App Check).
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
